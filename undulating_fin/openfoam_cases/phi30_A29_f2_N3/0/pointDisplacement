FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}
dimensions      [0 1 0 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    top
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    fin
    {
        type            codedFixedValue;
        redirectType    finMotion;
        value           uniform (0 0 0);
        name            finMotion;
        code
        #{
            // Motion is defined in system/finMotionCodeDict
            // or generated by the Python pre-processor.
            // This placeholder applies zero displacement;
            // replace with coded boundary from fin_motion.py output.
            const vectorField& points = patch().localPoints();
            vectorField& disp = *this;
            disp = vector::zero;
        #};
    }
    frontAndBack
    {
        type            empty;
    }
}
