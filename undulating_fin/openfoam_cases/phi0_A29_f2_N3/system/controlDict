FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     pimpleDyMFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1.5;
deltaT          0.0025;
writeControl    adjustableRunTime;
writeInterval   0.025;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           1.0;

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        patches         (fin);
        rho             rhoInf;
        rhoInf          1022.0;
        CofR            (0 0 0);
        log             true;
    }
}
